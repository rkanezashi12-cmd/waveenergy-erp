# デモ環境の設定（秘密情報ではない値だけ）。GitHub Actions（.github/workflows/gcp.yml）が読む。
# TODO の値は infra/setup.sh の最後に出る。秘密情報（DBの接続文字列・Auth.js の鍵・初期パスワード）は Secret Manager にある。
APP=weorder
GCP_PROJECT_ID=waveenergy-erp
GCP_PROJECT_NUMBER=TODO_setup.sh の出力
REGION=asia-northeast1
WIF_PROVIDER=TODO_setup.sh の出力
DEPLOYER_SA=weorder-deployer@waveenergy-erp.iam.gserviceaccount.com
APP_SA=weorder-app@waveenergy-erp.iam.gserviceaccount.com
SCHEDULER_SA=weorder-scheduler@waveenergy-erp.iam.gserviceaccount.com
BUDGET_STOP_SA=weorder-budget-stop@waveenergy-erp.iam.gserviceaccount.com
SQL_CONNECTION=waveenergy-erp:asia-northeast1:weorder-db
UPLOAD_BUCKET=waveenergy-erp-weorder-uploads
# ここから下はアプリの設定
APP_ENV=demo
AUTH_PASSWORD_LOGIN=true
MAIL_TRANSPORT=db
MAIL_FROM=no-reply@example.com
AI_PROVIDER=vertex
# モデル名は推測しない。Actions の models で、このプロジェクトで使える名前を確かめてから決める。
# 新しいプロジェクトでは古いモデル（gemini-2.5-flash など）が 404 になる（スキル gcp-bootstrap）。
# 東京リージョン（asia-northeast1）で使えれば asia-northeast1 にする。global は処理場所が日本とは限らない【要確認：SPEC §4.4】
GEMINI_MODEL=gemini-3.8-flash
VERTEX_LOCATION=global
DB_POOL_MAX=5
MIN_INSTANCES=0
MAX_INSTANCES=3
# シード（デモユーザーとサンプルオーダーは架空のデータ）
SEED_DEMO_USERS=true
SEED_SAMPLE_ORDERS=true
SEED_MUST_CHANGE_PASSWORD=true
# 予算を使い切ったら請求先を外して止める（デモだけ true。本番は false）
AUTO_STOP_ENABLED=true
