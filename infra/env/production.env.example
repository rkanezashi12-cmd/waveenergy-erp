# 本番環境（Wave Energy様の GCP）の設定の雛形。本番のプロジェクトで infra/setup.sh を実行したあと、
# production.env にコピーして値を入れる（本番の setup.sh は AUTO_STOP=false、SQL_TIER・SQL_AVAILABILITY を指定して実行する）。
APP=weorder
GCP_PROJECT_ID=TODO_本番のプロジェクトID
GCP_PROJECT_NUMBER=TODO_setup.sh の出力
REGION=asia-northeast1
WIF_PROVIDER=TODO_setup.sh の出力
DEPLOYER_SA=weorder-deployer@TODO_本番のプロジェクトID.iam.gserviceaccount.com
APP_SA=weorder-app@TODO_本番のプロジェクトID.iam.gserviceaccount.com
SCHEDULER_SA=weorder-scheduler@TODO_本番のプロジェクトID.iam.gserviceaccount.com
BUDGET_STOP_SA=weorder-budget-stop@TODO_本番のプロジェクトID.iam.gserviceaccount.com
SQL_CONNECTION=TODO_本番のプロジェクトID:asia-northeast1:weorder-db
UPLOAD_BUCKET=TODO_本番のプロジェクトID-weorder-uploads
APP_ENV=production
# M9（Entra ID）の準備ができたら false にする
AUTH_PASSWORD_LOGIN=true
# M9（Graph）の準備ができたら graph にする（GRAPH_* は Secret Manager に入れる）
MAIL_TRANSPORT=db
MAIL_FROM=TODO_送信元アドレス
AI_PROVIDER=vertex
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=asia-northeast1
DB_POOL_MAX=5
MIN_INSTANCES=0
MAX_INSTANCES=3
# 本番はマスタだけを登録する（最初の管理者は create-admin で作る）
SEED_DEMO_USERS=false
SEED_SAMPLE_ORDERS=false
SEED_MUST_CHANGE_PASSWORD=true
AUTO_STOP_ENABLED=false
