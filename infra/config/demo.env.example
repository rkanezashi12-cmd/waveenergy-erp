# ── デモ環境の設定（金指のGCPプロジェクト）──
# このファイルを infra/config/demo.env にコピーして値を書き換える。
#   cp infra/config/demo.env.example infra/config/demo.env
# *.env は Git に含めない（.gitignore 済み）。秘密情報はここに書かず、Secret Manager に登録する（06-secrets.sh）。

# ───────── プロジェクト ─────────
PROJECT_ID="we-order-demo"            # GCPプロジェクトID（§10.1 手順1で作成したもの）
REGION="asia-northeast1"              # 東京リージョン（SPEC §8）
APP_ENV="demo"                        # demo / production

# ───────── Cloud Run ─────────
SERVICE_NAME="we-order"               # Cloud Run サービス名
RUN_MIN_INSTANCES=0                   # 0 = 使わないときは停止（費用節約。初回アクセスが数秒遅くなる）
RUN_MAX_INSTANCES=3
RUN_CPU=1
RUN_MEMORY="1Gi"
RUN_CONCURRENCY=40                    # 1インスタンスあたりの同時リクエスト数
RUN_TIMEOUT=300                       # 秒（AI下書きは60秒以内が目安）
# 公開方法：no-invoker-iam-check（推奨。allUsers を使わずに公開）/ allUsers
PUBLIC_ACCESS_MODE="no-invoker-iam-check"
# 独自ドメインを使う場合だけ指定（空なら Cloud Run のURLを使う）
APP_BASE_URL=""

# ───────── Artifact Registry ─────────
AR_REPOSITORY="we-order"
APP_IMAGE_NAME="we-order-app"
TOOLS_IMAGE_NAME="we-order-tools"
# 07-deploy.sh でのビルド方法：cloudbuild（Cloud Build。手元にDocker不要）/ docker（手元のDocker）
BUILD_MODE="cloudbuild"

# ───────── Cloud SQL（PostgreSQL）─────────
SQL_INSTANCE="we-order-db"
SQL_DATABASE_VERSION="POSTGRES_16"
SQL_EDITION="enterprise"              # db-f1-micro などの共有コアは Enterprise エディションのみ
SQL_TIER="db-f1-micro"                # デモは最小構成（同時接続は25まで）
SQL_STORAGE_SIZE_GB=10
SQL_AVAILABILITY_TYPE="zonal"         # zonal / regional（高可用性。費用は約2倍）
SQL_BACKUP_START_TIME="18:00"         # UTC（= 日本時間 3:00）
SQL_RETAINED_BACKUPS=7                # 自動バックアップの保持数（SPEC §8：7日）
SQL_PITR_LOG_DAYS=7                   # ポイントインタイムリカバリ用ログの保持日数
SQL_DELETION_PROTECTION="true"
DB_NAME="we_order"
DB_USER="we_app"
DB_POOL_MAX=5                         # アプリ1インスタンスあたりのDB接続数の上限

# ───────── Cloud Storage ─────────
UPLOAD_BUCKET="${PROJECT_ID}-uploads"       # AI入力ファイルの一時保存先（30日で自動削除）
UPLOAD_RETENTION_DAYS=30
BUILD_STAGING_BUCKET="${PROJECT_ID}-build-src"  # Cloud Build に送るソースの置き場（7日で自動削除）

# ───────── サービスアカウント ─────────
RUNTIME_SA_NAME="we-order-runtime"    # Cloud Run の実行用
DEPLOYER_SA_NAME="we-order-deployer"  # GitHub Actions・Cloud Build 用
SCHEDULER_SA_NAME="we-order-scheduler" # Cloud Scheduler の OIDC トークン用
# デプロイSAの Cloud Run 権限（roles/run.admin / roles/run.developer。04-service-accounts.sh の注を参照）
DEPLOYER_RUN_ROLE="roles/run.admin"

# ───────── Secret Manager ─────────
SECRET_PREFIX="we-order-"

# ───────── GitHub Actions（Workload Identity Federation）─────────
GITHUB_REPOSITORY="OWNER/REPO"        # 例：funaisoken/waveenergy-erp
GITHUB_ENVIRONMENT="demo"             # GitHub の Environment 名（このジョブからのみデプロイを許可）
GITHUB_BRANCH=""                          # 空なら全ブランチ。指定するとそのブランチからのデプロイだけを許可
WIF_POOL_ID="github"
WIF_PROVIDER_ID="github-actions"

# ───────── アプリの設定 ─────────
AUTH_PASSWORD_LOGIN="true"            # デモはメールアドレス＋パスワード
MAIL_TRANSPORT="db"                   # db / smtp / graph（デモはDB保存のみ）
MAIL_FROM="no-reply@example.com"
# SMTP を使う場合（パスワードは 06-secrets.sh で Secret Manager に登録）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
# Microsoft Graph / Entra ID（M9。秘密情報は 06-secrets.sh で登録）
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_SENDER=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# AI下書き
AI_PROVIDER="vertex"                  # vertex / mock
GEMINI_MODEL="gemini-2.5-flash"
VERTEX_LOCATION="asia-northeast1"

# ───────── シード ─────────
SEED_MUST_CHANGE_PASSWORD="true"      # 初回ログイン時にパスワード変更を求める（SPEC §6）
SEED_SAMPLE_ORDERS="true"             # サンプルオーダー（架空データ）を作る
SEED_DEMO_USERS="true"                # デモユーザー（@example.com）を作る

# ───────── Cloud Scheduler ─────────
SCHEDULER_LOCATION="asia-northeast1"
SCHEDULER_TIME_ZONE="Asia/Tokyo"
DIGEST_SCHEDULE="0 8 * * 1-5"         # 毎朝のまとめ通知：平日 8:00
REMINDER_SCHEDULE="0 8-18 * * 1-5"    # 受入催促：平日 8:00〜18:00 の毎正時
