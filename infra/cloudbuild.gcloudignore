# gcloud builds submit で Cloud Build に送らないファイル（07-deploy.sh が --ignore-file で指定する）
# 書式は .gitignore と同じ。秘密情報（.env）とプロジェクト固有の設定は送らない。
.git
.github
.env
.env.*
!.env.example
node_modules/
.next/
out/
build/
coverage/
src/generated/
*.tsbuildinfo
.local-uploads/
e2e/
test-results/
playwright-report/
infra/config/*.env
.DS_Store
