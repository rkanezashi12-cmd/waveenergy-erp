# ── ローカル開発用の環境変数（.env にコピーして使う）──
# 環境固有値はすべて環境変数で渡す（SPEC §0-6）。本番では Secret Manager から渡す。

# データベース（docker compose の PostgreSQL）
DATABASE_URL="postgresql://we_app:we_app@localhost:5432/we_order?schema=public"

# Auth.js のセッション暗号化キー（openssl rand -base64 32 などで生成）
AUTH_SECRET="change-me"

# demo / production（production では送信メール履歴画面を出さない）
APP_ENV="demo"
# 通知メールに載せるアプリのURL
APP_BASE_URL="http://localhost:3000"

# パスワードログイン（本番では false にして Microsoft Entra ID のみにする）
AUTH_PASSWORD_LOGIN="true"
# Microsoft Entra ID（M9。設定すると「Microsoftアカウントでログイン」を表示）
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<テナントID>/v2.0/"

# メール送信方式：db（DB保存のみ）/ smtp / graph
MAIL_TRANSPORT="db"
MAIL_FROM="no-reply@example.com"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# GRAPH_TENANT_ID=""
# GRAPH_CLIENT_ID=""
# GRAPH_CLIENT_SECRET=""
# GRAPH_SENDER="shared-mailbox@example.com"

# AI下書き：vertex（Vertex AI）/ mock（GCPなしで動かす簡易版）
AI_PROVIDER="mock"
GOOGLE_CLOUD_PROJECT=""
GEMINI_MODEL="gemini-2.5-flash"
VERTEX_LOCATION="asia-northeast1"
# AI入力ファイルの一時保存先バケット（未設定ならローカルの .local-uploads に保存）
UPLOAD_BUCKET=""

# 定期処理エンドポイントの認証（ローカルは共有シークレット、GCPでは OIDC）
CRON_SECRET="local-cron-secret"
# CRON_OIDC_AUDIENCE="https://<Cloud Run のURL>"
# CRON_SERVICE_ACCOUNT="we-order-scheduler@<プロジェクトID>.iam.gserviceaccount.com"

# シード
SEED_DEMO_PASSWORD="Demo1234!"
SEED_MUST_CHANGE_PASSWORD="false"
